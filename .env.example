# =====================================================================
# Pick ONE LLM option. Options B and C cost nothing.
# =====================================================================

# --- Option A: Anthropic (paid) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Option B: Google Gemini free tier (no cost; key from aistudio.google.com) ---
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=your-gemini-key
# OPENAI_MODEL=copy-a-free-Flash-model-id-from-AI-Studio
# stay under free requests-per-minute limits:
# LLM_MIN_SECONDS_BETWEEN_CALLS=13
# LLM_PARALLEL_CALLS=1
# less hidden 'thinking' = fewer cut-off replies:
# LLM_REASONING_EFFORT=low

# --- Option C: fully local with Ollama (no cost, no key; needs a decent PC) ---
#   install ollama, then:  ollama pull qwen2.5:14b   (or llama3.1:8b on smaller machines)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:14b
# LLM_PARALLEL_CALLS=1
# smaller prompts for local models:
# MAX_PROMPT_CHARS=24000
# EXCERPT_CHARS_PER_SOURCE=4000

# Any other OpenAI-compatible endpoint (Groq, OpenRouter, OpenAI) works the same way.

# =====================================================================
# Web search: Tavily free plan = 1,000 credits/month, no card (tavily.com).
# One run uses roughly 50 credits. Leave empty to use DuckDuckGo (free, weaker).
# =====================================================================
TAVILY_API_KEY=

# =====================================================================
# SEC EDGAR: free. Just identify yourself (name + email). No signup.
# =====================================================================
SEC_USER_AGENT="Your Name your.email@example.com"

VENDOR_NAME=FlytBase
VENDOR_SITE=https://flytbase.com
